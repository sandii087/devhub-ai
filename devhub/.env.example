# Copy to .env. Development credentials are local-only; never use them in production.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://devhub:devhub@127.0.0.1:5432/devhub
APP_ORIGIN=http://localhost:5174
DEV_AUTH_ENABLED=true

# Register APP_ORIGIN/auth/callback with your OIDC provider.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Read-only GitHub App. Private key is PEM text injected by your secret manager.
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Explicit installation-to-organization bindings, e.g. 123:organization-uuid.
# An operator verifies ownership out-of-band before setting a binding.
GITHUB_INSTALLATION_BINDINGS=

# Optional AI. Choose a model available to your account; no implicit model fallback.
OPENAI_API_KEY=
OPENAI_MODEL=
